<?xml version="1.0" encoding="utf-8"?>
<com.znsoooo.qrscan.AdaptiveLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f2f3f5"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="12dp">

    <!-- 摄像头预览容器：高度由代码动态分配；画面按正方形裁切，容器变矮时底部被裁剪 -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:clipChildren="true"
        android:background="@drawable/bg_preview"
        android:layout_marginBottom="12dp">

        <TextureView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 识别成功弹窗：位于摄像头画面之上 -->
        <TextView
            android:id="@+id/overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:maxWidth="320dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/bg_overlay"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- 识别结果：只读、可长按选取、不弹键盘；高度由代码动态分配（最小 120dp） -->
    <ScrollView
        android:id="@+id/scrollResult"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@drawable/bg_result"
        android:padding="14dp"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="#1D2129"
            android:lineSpacingExtra="4dp"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- 总字数提示 + 添加换行复选框（右对齐） -->
    <LinearLayout
        android:id="@+id/countRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:text="总字数：0"
            android:textColor="#86909C"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbAddNewline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:text="添加换行"
            android:textColor="#86909C"
            android:textSize="13sp"
            android:button="@null"
            android:drawableEnd="@drawable/cb_newline"
            android:drawablePadding="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- 按钮行：复制 / 转换 / 清空 -->
    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnCopy"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_primary"
            android:text="复制"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnConvert"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/btn_secondary"
            android:text="转换"
            android:textAllCaps="false"
            android:textColor="#1D2129"
            android:textSize="14sp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_secondary"
            android:text="清空"
            android:textAllCaps="false"
            android:textColor="#1D2129"
            android:textSize="14sp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null" />
    </LinearLayout>

</com.znsoooo.qrscan.AdaptiveLayout>
